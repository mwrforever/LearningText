# 依赖与构建产物
node_modules/
dist/
out/
# build/ 为 electron-builder buildResources 目录：内容不入库，仅保留 .gitkeep 占位（宪法 B.1）
build/*
!build/.gitkeep
release/

# 测试与覆盖率产物（宪法 C.6-5）
coverage/
.vitest/
playwright-report/
test-results/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 本地环境与编辑器
.env
.env.local
.idea/
.vscode/

# SDD 技能工作区（评审包/报告/ledger，不入库）
.superpowers/
