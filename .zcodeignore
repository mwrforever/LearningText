# 依赖与构建产物
node_modules/
dist/
out/
# build/ 为 electron-builder buildResources 目录：内容不入库，仅保留 .gitkeep 占位（宪法 B.1）
build/*
!build/.gitkeep
release/

# 测试与覆盖率产物（宪法 C.6-5）
coverage/
.vitest/
playwright-report/
test-results/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 本地环境与编辑器
.env
.env.local
.idea/
.vscode/

# SDD 技能工作区（评审包/报告/ledger，不入库）
.superpowers/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
